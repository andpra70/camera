HOST_BIND=127.0.0.1
HOST_PORT=3000
PORT=3000
BASE_PATH=/
CAMERA_ALLOWLIST=
CAMERA_SCAN_INTERVAL_MS=10000
TARGET_WIDTH=640
TARGET_HEIGHT=480
TARGET_FPS=15
MAX_ACTIVE_CAMERAS=2
MAX_CLIENTS_PER_CAMERA=4
CAPTURE_START_TIMEOUT_MS=8000
CAPTURE_STALL_TIMEOUT_MS=10000
CAPTURE_IDLE_TIMEOUT_MS=3000
LOG_LEVEL=info
REGISTRY=docker.io/andpra70
IMAGE_NAME=ubuntu-camera-viewer
TAG=latest
# Required only with the devices override: numerical group owning /dev/videoN.
# VIDEO_GID=44
